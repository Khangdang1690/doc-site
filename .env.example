# Connection details for the sqld primary that backs FTS5 search.
# - Local dev: leave both blank; the indexer is a no-op and /api/search will
#   return a 500 unless you `sqlitedeploy dev` and point LIBSQL_URL at it.
# - Production (Oracle VM): set these in /opt/docs/env (loaded by systemd).

# Hrana HTTP URL of sqld. On the VM this is loopback; sqld is never exposed.
LIBSQL_URL=http://127.0.0.1:8080

# Replica JWT minted by `sqlitedeploy up`. Read from
# /home/sqld/db/.sqlitedeploy/auth/replica.jwt and paste the token value here.
LIBSQL_AUTH_TOKEN=
