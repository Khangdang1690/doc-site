# /etc/caddy/Caddyfile
#
# This config assumes the public ingress is a Cloudflare Worker on
# *.workers.dev (see ../worker/), so the VM only needs plain HTTP on
# port 80. Caddy's job here is gzip + access logs + bouncing requests
# that didn't come through the Worker.
#
# Replace WORKER_SECRET_HERE with the value you set via
# `wrangler secret put WORKER_SECRET`. They MUST match.

:80 {
	# Reject anything missing the shared secret. This makes
	# `curl http://<vm-ip>` from outside Cloudflare 401 out.
	@unauthorized not header X-Worker-Secret WORKER_SECRET_HERE
	respond @unauthorized "Forbidden" 401

	encode zstd gzip

	# Astro Node SSR is on the loopback.
	reverse_proxy 127.0.0.1:4321 {
		# The Worker already adds X-Forwarded-Host / X-Forwarded-Proto;
		# keep the real client IP so Astro logs show CF-Connecting-IP.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	@astro_assets path /_astro/*
	header @astro_assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/docs-site.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
