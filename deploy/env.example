# Astro Node adapter listens on these.
HOST=127.0.0.1
PORT=4321

# Connection to the local sqld primary (loopback only — sqld is never exposed).
LIBSQL_URL=http://127.0.0.1:8080
LIBSQL_AUTH_TOKEN=PASTE_CONTENTS_OF_/home/sqld/db/.sqlitedeploy/auth/replica.jwt
