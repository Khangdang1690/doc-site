---
// Replaces Starlight's default Pagefind search. Calls /api/search which runs
// an FTS5 query against the sqld instance. The component is rendered in the
// site header by Starlight's `components.Search` override (see astro.config.mjs).
---

<div class="sd-search">
	<button type="button" class="sd-trigger" aria-label="Search" data-open-search>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="8"></circle>
			<path d="m21 21-4.35-4.35"></path>
		</svg>
		<span>Search</span>
		<kbd>⌘K</kbd>
	</button>

	<dialog class="sd-dialog" aria-label="Search documentation">
		<form class="sd-form" role="search">
			<input
				type="search"
				name="q"
				placeholder="Search docs…"
				autocomplete="off"
				autocorrect="off"
				autocapitalize="off"
				spellcheck="false"
			/>
			<button type="button" class="sd-close" data-close-search aria-label="Close">Esc</button>
		</form>
		<ul class="sd-results" aria-live="polite"></ul>
		<p class="sd-empty" hidden>No matches.</p>
		<p class="sd-hint">Powered by SQLite FTS5 on a sqld instance — see <a href="/guides/how-it-works/">How it works</a>.</p>
	</dialog>
</div>

<script>
	type Hit = { slug: string; title: string; description: string; snippet: string };

	const trigger = document.querySelector<HTMLButtonElement>('[data-open-search]');
	const dialog = document.querySelector<HTMLDialogElement>('.sd-dialog');
	const closeBtn = document.querySelector<HTMLButtonElement>('[data-close-search]');
	const input = dialog?.querySelector<HTMLInputElement>('input[name="q"]');
	const results = dialog?.querySelector<HTMLUListElement>('.sd-results');
	const empty = dialog?.querySelector<HTMLParagraphElement>('.sd-empty');

	if (!trigger || !dialog || !input || !results || !empty || !closeBtn) {
		// Should never happen — fail silent rather than break the page.
		console.warn('SearchBox: missing required nodes');
	} else {
		const open = () => {
			dialog.showModal();
			input.value = '';
			results.innerHTML = '';
			empty.hidden = true;
			requestAnimationFrame(() => input.focus());
		};
		const close = () => dialog.close();

		trigger.addEventListener('click', open);
		closeBtn.addEventListener('click', close);

		document.addEventListener('keydown', (e) => {
			if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
				e.preventDefault();
				open();
			}
		});

		dialog.addEventListener('click', (e) => {
			// Click on backdrop closes; click inside the form does not.
			if (e.target === dialog) close();
		});

		let abort: AbortController | null = null;
		let timer: ReturnType<typeof setTimeout> | null = null;

		const render = (hits: Hit[]) => {
			if (hits.length === 0) {
				results.innerHTML = '';
				empty.hidden = false;
				return;
			}
			empty.hidden = true;
			results.innerHTML = hits
				.map((h) => `
					<li>
						<a href="/${h.slug}/">
							<strong>${escapeHtml(h.title)}</strong>
							${h.description ? `<small>${escapeHtml(h.description)}</small>` : ''}
							<span class="sd-snippet">${h.snippet}</span>
						</a>
					</li>
				`)
				.join('');
		};

		input.addEventListener('input', () => {
			if (timer) clearTimeout(timer);
			if (abort) abort.abort();
			const q = input.value.trim();
			if (q.length < 2) {
				results.innerHTML = '';
				empty.hidden = true;
				return;
			}
			timer = setTimeout(async () => {
				abort = new AbortController();
				try {
					const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`, { signal: abort.signal });
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const hits = (await res.json()) as Hit[];
					render(hits);
				} catch (err) {
					if (!(err instanceof DOMException && err.name === 'AbortError')) {
						results.innerHTML = `<li class="sd-error">Search unavailable: ${escapeHtml(String(err))}</li>`;
					}
				}
			}, 120);
		});
	}

	function escapeHtml(s: string): string {
		return s.replace(/[&<>"']/g, (c) =>
			({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c),
		);
	}
</script>

<style>
	.sd-search { display: inline-flex; align-items: center; }

	.sd-trigger {
		display: inline-flex; align-items: center; gap: 0.65rem;
		padding: 0.45rem 0.7rem;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--brand-ink-2);
		background: var(--brand-bg);
		border: 1.5px solid var(--brand-ink);
		border-radius: 0;
		box-shadow: 3px 3px 0 var(--brand-ink);
		cursor: pointer;
		min-width: 13rem;
		transition: transform 80ms, box-shadow 80ms, background 80ms;
	}
	.sd-trigger:hover {
		transform: translate(-2px, -2px);
		box-shadow: 5px 5px 0 var(--brand-accent);
		background: var(--brand-bg-2);
	}
	.sd-trigger svg {
		color: var(--brand-accent);
	}
	.sd-trigger kbd {
		margin-left: auto;
		font: inherit; font-size: 0.7rem;
		padding: 0.05rem 0.4rem;
		background: var(--brand-ink);
		color: var(--brand-bg);
		border-radius: 0;
		border: none;
		font-weight: 600;
	}

	.sd-dialog {
		width: min(42rem, 92vw);
		max-height: 72vh;
		padding: 0;
		border: 1.5px solid var(--brand-ink);
		border-radius: 0;
		background: var(--brand-bg);
		color: var(--brand-ink);
		box-shadow: 8px 8px 0 var(--brand-ink);
		overflow: hidden;
	}
	.sd-dialog::backdrop {
		background: rgba(20, 19, 15, 0.4);
		backdrop-filter: blur(2px);
	}

	.sd-form {
		display: flex; align-items: center; gap: 0.5rem;
		padding: 0.85rem 1rem;
		border-bottom: 1.5px solid var(--brand-ink);
		background: var(--brand-bg-2);
	}
	.sd-form::before {
		content: 'fts5 ›';
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--brand-accent);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.sd-form input {
		flex: 1;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 1rem;
		padding: 0.4rem 0;
		background: transparent;
		color: inherit;
		border: none; outline: none;
	}
	.sd-close {
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		padding: 0.25rem 0.5rem;
		background: var(--brand-ink);
		color: var(--brand-bg);
		border: none;
		border-radius: 0;
		cursor: pointer;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 600;
	}

	.sd-results {
		list-style: none; padding: 0; margin: 0;
		max-height: calc(72vh - 7rem);
		overflow-y: auto;
	}
	.sd-results li {
		border-bottom: 1px dashed var(--brand-line);
	}
	.sd-results li:last-child { border-bottom: none; }
	.sd-results a {
		display: block;
		padding: 0.85rem 1rem;
		color: inherit; text-decoration: none;
		border-left: 3px solid transparent;
		transition: background 80ms, border-color 80ms;
	}
	.sd-results a:hover, .sd-results a:focus {
		background: var(--brand-bg-2);
		border-left-color: var(--brand-accent);
	}
	.sd-results strong {
		display: block;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.92rem;
		font-weight: 700;
	}
	.sd-results small {
		display: block;
		color: var(--brand-ink-3);
		font-size: 0.78rem;
		margin-top: 0.15rem;
	}
	.sd-snippet {
		display: block;
		font-size: 0.85rem;
		color: var(--brand-ink-2);
		margin-top: 0.35rem;
		line-height: 1.4;
	}
	.sd-snippet :global(mark) {
		background: var(--brand-accent);
		color: var(--brand-bg);
		padding: 0 0.2rem;
		border-radius: 0;
		font-weight: 500;
	}

	.sd-empty, .sd-hint {
		margin: 0;
		padding: 0.75rem 1rem;
		color: var(--brand-ink-3);
		font-size: 0.78rem;
		font-family: 'JetBrains Mono', ui-monospace, monospace;
	}
	.sd-hint {
		border-top: 1px dashed var(--brand-line);
		background: var(--brand-bg-2);
	}
	.sd-hint a {
		color: var(--brand-ink);
		text-decoration: underline;
		text-decoration-color: var(--brand-accent);
		text-underline-offset: 3px;
	}
	.sd-error {
		padding: 0.75rem 1rem;
		color: var(--brand-accent);
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.85rem;
	}
</style>
